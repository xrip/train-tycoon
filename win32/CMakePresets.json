{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "windows-x64",
      "displayName": "Visual Studio 2022 x64",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build"
    }
  ],
  "buildPresets": [
    {
      "name": "build-debug",
      "configurePreset": "windows-x64",
      "configuration": "Debug"
    },
    {
      "name": "build-release",
      "configurePreset": "windows-x64",
      "configuration": "Release"
    }
  ],
  "testPresets": [
    {
      "name": "test-debug-fast",
      "configurePreset": "windows-x64",
      "configuration": "Debug",
      "filter": {
        "include": {
          "label": "fast"
        }
      },
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "test-debug-full",
      "configurePreset": "windows-x64",
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "test-release-full",
      "configurePreset": "windows-x64",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
